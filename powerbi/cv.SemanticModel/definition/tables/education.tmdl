	measure 'Education Line' =
			MAXX (
			    education,
			    education[degree] & ", " & education[field] & " — "
			        & education[institution] & ", "
			        & FORMAT ( education[start_date], "yyyy" ) & "–"
			        & FORMAT ( education[end_date], "yyyy" )
			)
