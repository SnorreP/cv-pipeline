table experience
	lineageTag: bab9f28d-ad2c-4359-bed8-dbf5dd9a885f

	measure 'Covered Months' =
			VAR Lang = SELECTEDVALUE ( languages[code], "en" )
			VAR Rows = FILTER ( ALL ( experience ), experience[language] = Lang )
			VAR FirstStart = MINX ( Rows, experience[start_date] )
			VAR MonthCount = DATEDIFF ( FirstStart, TODAY (), MONTH )
			VAR AllMonths =
			    SELECTCOLUMNS (
			        GENERATESERIES ( 0, MonthCount, 1 ),
			        "@Month", EDATE ( FirstStart, [Value] )
			    )
			VAR CoveredList =
			    FILTER (
			        AllMonths,
			        VAR ThisMonth = [@Month]
			        RETURN
			            NOT ISEMPTY (
			                FILTER (
			                    Rows,
			                    experience[start_date] <= EOMONTH ( ThisMonth, 0 )
			                        && COALESCE ( experience[end_date], TODAY () ) >= ThisMonth
			                )
			            )
			    )
			RETURN
			    IF ( ISBLANK ( FirstStart ), BLANK (), COUNTROWS ( CoveredList ) )
		formatString: 0
		isHidden
		lineageTag: 9b43cf83-6983-419b-9d93-5e3182eeeac3

	measure 'Years of Experience' = ROUND ( DIVIDE ( [Covered Months], 12 ), 1 )
		formatString: 0.0
		lineageTag: 905945f5-e44e-4525-887f-7d268b163043

	measure 'Current Tenure' =
			VAR s =
			    CALCULATE ( MIN ( experience[start_date] ), experience[is_current] = TRUE () )
			RETURN
			    IF ( ISBLANK ( s ), BLANK (), DATEDIFF ( s, TODAY (), MONTH ) / 12 )
		formatString: 0.0
		lineageTag: 3f321f9a-67ed-44c2-959c-c64591388129

	measure 'Career Since' =
			VAR Lang = SELECTEDVALUE ( languages[code], "en" )
			VAR Prefix = CALCULATE ( MAX ( labels[text] ), labels[key] = "since_prefix" )
			VAR FirstStart = MINX ( FILTER ( ALL ( experience ), experience[language] = Lang ), experience[start_date] )
			RETURN
			    Prefix & " " & FORMAT ( FirstStart, "MMM yyyy", IF ( Lang = "da", "da-DK", "en-US" ) )
		lineageTag: a328ccc6-35fe-46e5-8ec0-2b4ae441dc53

	measure 'Current Role Note' =
			VAR Prefix = CALCULATE ( MAX ( labels[text] ), labels[key] = "at_prefix" )
			RETURN
			    Prefix & " " & CALCULATE ( MAX ( experience[company] ), experience[is_current] = TRUE () )
		lineageTag: 71a36fa0-a131-4e8d-8a1e-adbbc4a659e0

	measure 'Timeline Start' =
			VAR s = MIN ( experience[start_date] )
			RETURN
			    IF ( ISBLANK ( s ), BLANK (), YEAR ( s ) + ( MONTH ( s ) - 1 ) / 12 )
		formatString: 0
		lineageTag: 52c2fb35-273d-4886-a79f-c6a437da9d27

	measure 'Timeline Duration' =
			VAR s = MIN ( experience[start_date] )
			VAR e = COALESCE ( MIN ( experience[end_date] ), TODAY () )
			RETURN
			    IF (
			        ISBLANK ( s ),
			        BLANK (),
			        ( YEAR ( e ) + ( MONTH ( e ) - 1 ) / 12 ) - ( YEAR ( s ) + ( MONTH ( s ) - 1 ) / 12 ) + 1 / 12
			    )
		formatString: 0
		lineageTag: 414cd7da-9a37-42da-b544-d69cf697dd29

	measure 'Timeline Bar Color' = IF ( SELECTEDVALUE ( experience[is_current] ) = TRUE (), "#2A78D6", "#A8A6A0" )
		lineageTag: 9c849997-4489-446c-84bf-73a76dc68edb

	measure 'Dates Label' =
			VAR s = SELECTEDVALUE ( experience[start_date] )
			VAR e = SELECTEDVALUE ( experience[end_date] )
			RETURN
			    IF (
			        ISBLANK ( s ),
			        BLANK (),
			        FORMAT ( s, "MMM yyyy" ) & " – " & IF ( ISBLANK ( e ), "today", FORMAT ( e, "MMM yyyy" ) )
			    )
		lineageTag: 9cf1dc5d-b74c-4f5c-9b80-f6a0f6ac0d22

