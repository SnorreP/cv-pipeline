		sourceColumn: proficiency

		annotation SummarizationSetBy = Automatic

	column years_experience
		dataType: double
		lineageTag: 8e8c0357-b32d-4677-afe0-6f143e4ca60c
		summarizeBy: sum
		sourceColumn: years_experience

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Skill Sort' = RANKX ( skills, skills[proficiency] * 100 + skills[years_experience],, DESC )
		lineageTag: 4310b327-fc31-4cf0-bc99-208c69d53f00
		summarizeBy: none

		annotation SummarizationSetBy = User

