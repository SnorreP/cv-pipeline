	column category
		dataType: string
		lineageTag: bd180b89-857d-47a3-a9ad-96025f4d94b4
		summarizeBy: none
		sourceColumn: category

		annotation SummarizationSetBy = Automatic

	column proficiency
		dataType: int64
		formatString: 0
		lineageTag: d2dadd12-0109-493d-9060-19443ba033df
